generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  stdId                     String                      @id
  title                     EnumNameTitle
  fName                     String
  lName                     String
  email                     String?                     @unique
  tel                       String?                     @unique
  googleId                  String?                     @unique
  lineId                    String?                     @unique
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  deletedAt                 DateTime?
  activity                  ActivityParticipate[]
  attendance                Attendance[]
  classroomMembers          ClassroomMember[]
  Leader                    Leader[]
  leaveRequest              LeaveRequest[]
  parent                    StudentParent[]
  behaviourScoreTransaction behaviourScoreTransaction[]
}

model Leader {
  ldrId      String                @id @default(uuid())
  stdId      String
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  deletedAt  DateTime?
  activity   ActivityParticipate[]
  attendance Attendance[]
  classroom  Classrooms[]
  student    Student               @relation(fields: [stdId], references: [stdId])
}

model Teacher {
  tchId                   String                    @id @default(uuid())
  fName                   String
  lName                   String
  email                   String?                   @unique
  tel                     String?                   @unique
  password                String?
  googleId                String?                   @unique
  lineId                  String?                   @unique
  deptId                  String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  deletedAt               DateTime?
  actParticipate          ActivityParticipate[]
  activity                ActivityTeacher[]
  attendance              Attendance[]
  classTeacher            ClassroomTeacher[]
  leaveRequestStudingTime LeaveRequestStudingTime[]
  subject                 Subject[]
  department              Department?               @relation(fields: [deptId], references: [deptId])
}

model Department {
  deptId    String    @id @default(uuid())
  deptName  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  teacher   Teacher[]
}

model Parent {
  prntId    String          @id @default(uuid())
  name      String
  email     String?         @unique
  tel       String?         @unique
  lineId    String?         @unique
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?
  student   StudentParent[]
}

model StudentParent {
  id        String    @id @default(uuid())
  stdId     String
  prntId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  parent    Parent    @relation(fields: [prntId], references: [prntId])
  student   Student   @relation(fields: [stdId], references: [stdId])
}

model Subject {
  subId       String      @id @default(uuid())
  subCode     String
  subNameThai String
  subNameEng  String?
  subCredit   Float
  tchId       String
  subTypeId   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  subjectType SubjectType @relation(fields: [subTypeId], references: [subTypeId])
  teacher     Teacher     @relation(fields: [tchId], references: [tchId])
  timetable   Timetable[]
}

model SubjectType {
  subTypeId       String    @id @default(uuid())
  subTypeNameThai String
  subTypeNameEng  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  subject         Subject[]
}

model Classrooms {
  classId          String                     @id @default(uuid())
  classLevel       Int
  classRoom        Int
  classTypeId      String
  termId           String
  ldrId            String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  deletedAt        DateTime?
  activity         ClassroomCanjoinActivity[]
  classroomMembers ClassroomMember[]
  classTeacher     ClassroomTeacher[]
  classroomType    ClassroomType              @relation(fields: [classTypeId], references: [classTypeId])
  leader           Leader?                    @relation(fields: [ldrId], references: [ldrId])
  term             AcademicTerms              @relation(fields: [termId], references: [termId])
  timetable        Timetable[]
}

model ClassroomMember {
  classRoomMemeberId String     @id @default(uuid())
  classId            String
  stdId              String
  stdNo              String
  behaviourScore     Float      @default(100)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?
  classroom          Classrooms @relation(fields: [classId], references: [classId])
  student            Student    @relation(fields: [stdId], references: [stdId])
}

model ClassroomType {
  classTypeId       String       @id @default(uuid())
  classTypeNameThai String
  classTypeNameEng  String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?
  classroom         Classrooms[]
}

model Timetable {
  timetableId String        @id @default(uuid())
  subId       String
  classId     String
  timeStart   String
  timeEnd     String
  timeLate    String
  dayOfWeek   Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  studyTime   StudingTime[]
  classroom   Classrooms    @relation(fields: [classId], references: [classId])
  subject     Subject       @relation(fields: [subId], references: [subId])
}

model StudingTime {
  studyTimeId               String                      @id @default(uuid())
  timetableId               String
  studingTimeDate           DateTime
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  deletedAt                 DateTime?
  attendance                Attendance[]
  leaveRequest              LeaveRequestStudingTime[]
  timetable                 Timetable                   @relation(fields: [timetableId], references: [timetableId])
  behaviourScoreTransaction behaviourScoreTransaction[]
}

model Attendance {
  attId         String               @id @default(uuid())
  stdId         String
  studingTimeId String
  attTimestamp  DateTime
  attStatus     EnumAttendanceStatus
  attMethodId   String
  latitute      Float?
  longitute     Float?
  note          String?
  operatedBy    String
  tchId         String?
  leaderId      String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  deletedAt     DateTime?
  attMethod     AttendanceMethod     @relation(fields: [attMethodId], references: [attMethodId])
  leader        Leader?              @relation(fields: [leaderId], references: [ldrId])
  student       Student              @relation(fields: [stdId], references: [stdId])
  studingTime   StudingTime          @relation(fields: [studingTimeId], references: [studyTimeId])
  teacher       Teacher?             @relation(fields: [tchId], references: [tchId])
}

model AttendanceMethod {
  attMethodId   String       @id @default(uuid())
  attMethodName String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?
  attendance    Attendance[]
}

model LeaveRequest {
  leaveId          String                    @id @default(uuid())
  stdId            String
  leaveDate        DateTime
  leaveTypeId      String
  leaveReason      String
  LeaveFile        String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  deletedAt        DateTime?
  leaveRequestType LeaveRequestType          @relation(fields: [leaveTypeId], references: [leaveTypeId])
  student          Student                   @relation(fields: [stdId], references: [stdId])
  studingTime      LeaveRequestStudingTime[]
}

model LeaveRequestType {
  leaveTypeId   String         @id @default(uuid())
  leaveTypeName String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  leaveRequest  LeaveRequest[]
}

model LeaveRequestStudingTime {
  leaveRequestStudingTimeId String          @id @default(uuid())
  leaveId                   String
  studyTimeId               String
  leaveStatus               EnumLeaveStatus @default(WAITING)
  tacherApproveId           String?
  approverTimestamp         DateTime?
  rejectedNote              String?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  deletedAt                 DateTime?
  leaveRequest              LeaveRequest    @relation(fields: [leaveId], references: [leaveId])
  studingTime               StudingTime     @relation(fields: [studyTimeId], references: [studyTimeId])
  teacherApprove            Teacher?        @relation(fields: [tacherApproveId], references: [tchId])
}

model Activity {
  actId           String                     @id @default(uuid())
  actName         String
  actDate         DateTime
  actDateEnd      DateTime
  actTypeId       String
  actStatus       EnumActivityStatus
  actDesc         String?
  actLocation     String?
  actStartTime    String?
  actEndTime      String?
  joinLimit       Boolean
  joinLimitNumber Int?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  deletedAt       DateTime?
  activityType    ActivityType               @relation(fields: [actTypeId], references: [actTypeId])
  actParticipate  ActivityParticipate[]
  teacher         ActivityTeacher[]
  classroom       ClassroomCanjoinActivity[]
}

model ActivityType {
  actTypeId   String     @id @default(uuid())
  actTypeName String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
  activity    Activity[]
}

model ActivityTeacher {
  actTeacherId String    @id @default(uuid())
  actId        String
  tchId        String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  activity     Activity  @relation(fields: [actId], references: [actId])
  teacher      Teacher   @relation(fields: [tchId], references: [tchId])
}

model ClassroomCanjoinActivity {
  classCanjoinId String     @id @default(uuid())
  classId        String
  actId          String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?
  activity       Activity   @relation(fields: [actId], references: [actId])
  classroom      Classrooms @relation(fields: [classId], references: [classId])
}

model ActivityParticipate {
  actParticipateId String    @id @default(uuid())
  actId            String
  stdId            String
  note             String?
  joinTimestamp    DateTime
  operateBy        String
  teacherId        String?
  leaderId         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  activity         Activity  @relation(fields: [actId], references: [actId])
  leader           Leader?   @relation(fields: [leaderId], references: [ldrId])
  student          Student   @relation(fields: [stdId], references: [stdId])
  teacher          Teacher?  @relation(fields: [teacherId], references: [tchId])
}

model Holiday {
  holidayId        String        @id @default(uuid())
  startHolidayDate DateTime
  endHolidayDate   DateTime
  holidayName      String
  type             holidayType
  termId           String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?
  term             AcademicTerms @relation(fields: [termId], references: [termId])
}

model AcademicTerms {
  termId       String       @id @default(uuid())
  academicYear Int
  semester     Int
  termStart    DateTime
  termEnd      DateTime
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?
  classroom    Classrooms[]
  holiday      Holiday[]
}

model ClassroomTeacher {
  classTeacherId String     @id @default(uuid())
  classId        String
  tchId          String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?
  classroom      Classrooms @relation(fields: [classId], references: [classId])
  teacher        Teacher    @relation(fields: [tchId], references: [tchId])
}

model Admin {
  adminId   String    @id @default(uuid())
  username  String    @unique
  name      String
  email     String?   @unique
  tel       String?   @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model behaviourScoreTransaction {
  id           String             @id @default(uuid())
  stdId        String
  stuingTimeId String
  score        Float
  Status       EnumBehaviourScore @default(DECREMENT)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?
  student      Student            @relation(fields: [stdId], references: [stdId])
  studingTime  StudingTime        @relation(fields: [stuingTimeId], references: [studyTimeId])
}

enum holidayType {
  RATCHAKHAN
  SCHOOL
}

enum EnumAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  ACTIVITY
  LEAVE
}

enum EnumLeaveStatus {
  WAITING
  APPROVED
  REJECTED
}

enum EnumNameTitle {
  BOY
  GIRL
  MR
  MS
}

enum EnumActivityStatus {
  PROCESSING
  FINISHED
}

enum EnumBehaviourScore {
  INCREMENT
  DECREMENT
}
