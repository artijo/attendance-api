generator client {
  provider = "prisma-client-js"
}

// if the DATABASE_URL env var is set, we connect to the production database
// otherwise, we connect to a local SQLite database

// datasource db {
//   provider = "mysql"
//   url      = env("DATABASE_URL")
// }

datasource db {
  provider = "sqlite"
  url      = "file:dev.db"
}
